# Server-only Vercel environment variables. Never prefix these with VITE_.
DATABASE_URL=parad://...
ACCX_VAULT_MASTER_KEY=
ACCX_ADMIN_KEY=
ACCX_WORKER_KEY=

# Nexuss Auth relying-party configuration. Keep these server-side; do not use VITE_.
NEXUSS_AUTH_URL=https://nexuss-auth.vercel.app
NEXUSS_AUTH_PROJECT_ID=
NEXUSS_AUTH_REDIRECT_URI=https://<accx-origin>/auth/nexuss/callback

# DATABASE_URL contains the encrypted Paradox database connection URL, including
# the project/database target, passphrase, active gateway, and API token.
# Keep it in Vercel Environment Variables or another secret manager only.
