# Server-only Vercel environment variables. Never prefix these with VITE_.
PARADOX_GATEWAY_URL=https://paradox-db.onrender.com/v1
PARADOX_API_KEY=
PARADOX_PASSPHRASE=
ACCX_VAULT_MASTER_KEY=
ACCX_ADMIN_KEY=
ACCX_WORKER_KEY=

# Public resolver only; it contains no API key or passphrase.
PARADOX_RESOLVER_URL=https://paradox-domain.onrender.com/active-domain.json
